# Google Play imza anahtarı bilgileri.
#
# Bu dosyayı "keystore.properties" olarak kopyala ve kendi bilgilerinle doldur.
# "keystore.properties" ve .keystore/.jks dosyaları .gitignore'da — GitHub'a gitmez.
#
# ⚠️ Anahtar dosyasını ve parolalarını KAYBETME. Kaybedersen uygulamayı
# Google Play'de bir daha güncelleyemezsin. Yedeğini güvenli bir yerde sakla.

storeFile=esnaflokantalari-release.keystore
storePassword=BURAYA_STORE_PAROLASI
keyAlias=esnaflokantalari
keyPassword=BURAYA_ANAHTAR_PAROLASI
